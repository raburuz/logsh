{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n SW,NEXT -c blue,green \"pnpm run sw:generate\" \"next dev\"",
    "pre:build": "pnpm run prod:drizzle:migrate",
    "build": "pnpm run pre:build && pnpm run prod:sw:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prod:sw:generate": "cross-env NODE_ENV=production node modules/push/watch-sw.ts",
    "prod:drizzle:migrate": "dotenv pnpm dlx tsx modules/db/scripts/migrate.ts",
    "dev:check:build": "pnpm run prod:sw:generate && next build",
    "dev:sw:generate": "node modules/push/watch-sw.ts",
    "dev:email": "email dev",
    "dev:drizzle:check": "drizzle-kit check --config ./modules/db/drizzle.config.ts",
    "dev:drizzle:generate": "drizzle-kit generate --config ./modules/db/drizzle.config.ts",
    "dev:drizzle:push": "drizzle-kit push --config ./modules/db/drizzle.config.ts",
    "dev:drizzle:migration:custom": "drizzle-kit generate --custom --config ./modules/db/drizzle.config.ts --name",
    "dev:better-auth:schema:generate": "pnpm dlx @better-auth/cli@latest generate --config ./modules/auth/lib/server.ts --output ./modules/db/schemas/auth.ts",
    "dev:better-auth:schema:migrate": "pnpm dlx @better-auth/cli@latest migrate --config ./modules/auth/lib/server.ts"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.4.18",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@parcel/watcher": "^2.5.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.8",
    "@tailwindcss/postcss": "^4.2.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/mdx": "^2.0.13",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.34.3",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "node-emoji": "^2.2.0",
    "ogl": "^1.0.11",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "rate-limiter-flexible": "^9.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "rehype-pretty-code": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.2",
    "sonner": "^2.0.7",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.1",
    "eslint-config-next": "16.1.6",
    "react-email": "5.2.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
