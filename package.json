{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n SW,NEXT -c blue,green \"pnpm run sw:generate\" \"next dev\"",
    "build": "pnpm run sw:generate && next build",
    "start": "next start",
    "sw:generate": "node modules/push/watch-sw.ts",
    "lint": "eslint",
    "drizzle:generate": "drizzle-kit generate --config ./modules/db/drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config ./modules/db/drizzle.config.ts",
    "drizzle:migration:custom": "drizzle-kit generate --custom --config ./modules/db/drizzle.config.ts --name",
    "better-auth:schema:generate": "pnpm dlx @better-auth/cli@latest generate --config ./modules/auth/lib/server.ts --output ./modules/db/schemas/auth.ts",
    "better-auth:schema:migrate": "pnpm dlx @better-auth/cli@latest migrate --config ./modules/auth/lib/server.ts"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.4.17",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@parcel/watcher": "^2.5.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/mdx": "^2.0.13",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "better-auth": "^1.4.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.32.0",
    "ioredis": "^5.9.2",
    "lucide-react": "^0.563.0",
    "next": "16.1.5",
    "next-themes": "^0.4.6",
    "node-emoji": "^2.2.0",
    "pg": "^8.17.2",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "rate-limiter-flexible": "^9.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "rehype-pretty-code": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.1",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
